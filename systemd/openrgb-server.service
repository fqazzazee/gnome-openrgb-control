[Unit]
Description=OpenRGB SDK server (used by the RGB Lighting GNOME extension)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/openrgb --server --server-host 127.0.0.1 --noautoconnect
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
