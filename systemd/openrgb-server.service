[Unit]
Description=OpenRGB SDK server (used by the RGB Lighting GNOME extension)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Runs with the GUI minimized to the tray: headless --server skips plugins,
# so profiles that carry Effects plugin settings would load without effects.
ExecStart=/usr/bin/openrgb --server --server-host 127.0.0.1 --startminimized --noautoconnect
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
